  "cursor": {
    "step": 6,
    "per_day": 6,
    "order": [
      "cover",
      "scene",
      "insight",
      "method",
      "gentle",
      "cta"
    ],
    "D": "day_num（每晚连续，公式不变）",
    "formula": "photos[(D*6+k)%N]，k=0…5对应order；crop按(D+k)%2选cropA(偶)/cropB(奇)",
    "note": "mod-4轮换已废弃：每晚固定F后cursor按连续day_num取图即天然零重合，无需取模选套。"
