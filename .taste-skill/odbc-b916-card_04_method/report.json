      "top": 385,
      "tag": "p",
      "kind": "statement"
     },
     {
      "text": "一，默念三秒，我的下班，我做主。",
      "words": 1,
      "chars": 16,
      "lines": 1,
      "size": 28,
      "vw": 2.6,
