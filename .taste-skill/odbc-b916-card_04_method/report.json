      "top": 636,
      "tag": "p",
      "kind": "statement"
     },
     {
      "text": "三，出门别回头，轻快会追上你。",
      "words": 1,
      "chars": 15,
      "lines": 1,
      "size": 28,
      "vw": 2.6,
