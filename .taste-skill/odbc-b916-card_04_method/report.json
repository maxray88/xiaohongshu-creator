      "position": "center",
      "widthRatio": 0.76,
      "top": 492,
      "tag": "p",
      "kind": "statement"
     },
     {
      "text": "二，直接站起来收拾包。不解释，不道歉。",
      "words": 1,
      "chars": 19,
      "lines": 1,
      "size": 28,
      "vw": 2.6,
      "font": "Noto Sans SC",
